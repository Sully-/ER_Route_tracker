# Backend API URL for local development.
# Must match the OAuth redirect URIs registered with Discord/Google/Twitch:
#   https://localhost:7169/signin-discord
#   https://localhost:7169/signin-google
#   https://localhost:7169/signin-twitch
#
# Run the backend with: dotnet run --launch-profile https
VITE_BACKEND_URL=https://localhost:7169
